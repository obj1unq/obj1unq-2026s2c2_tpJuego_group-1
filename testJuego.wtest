import juego.*
import mainJuego.config
import jugador.jugador

//import wollok.game.*

describe "group of tests for player" {

  method initialize() {
    config.configurarEscenario()
  }
  test "jugador tiene posicion e imagen" {
    assert.equals(game.center(), jugador.position())
    assert.equals("Jugador.png", jugador.image())
  }

}

describe "Test sobre Jugador" {

  method initialize() {
    config.configurarEscenario()
  }

  test "Sacar Vida al jugador" {
    jugador.descontarVida(50)
    assert.equals(50, jugador.vidaActualmente())
    jugador.descontarVida(20)
    assert.equals(30, jugador.vidaActualmente())
    jugador.descontarVida(40)
    assert.equals(0, jugador.vidaActualmente())
    assert.notThat(game.hasVisual(jugador))
  }

    test "Desidratar e hidratar al jugador" {
      const agua1 = new Agua()
      jugador.consumirAgua()
      assert.equals(14, jugador.nivelDeAgua())
      jugador.hidratarse(agua1.aguaQueAporta())
      assert.equals(19, jugador.nivelDeAgua())
      jugador.hidratarse(150)
      assert.equals(100, jugador.nivelDeAgua())
    }

  test "Agregar Y sacar en Inventario"{
    jugador.agregarAlInventario(serrucho)
    jugador.agregarAlInventario(llave)
    assert.equals([serrucho,llave], jugador.inventarioActual())

    jugador.eliminarATodosDelInventario()

    assert.equals([], jugador.inventarioActual())

  }
}

describe "Logica de agarrar Objeto" {

  method initialize() {
    config.configurarEscenario()
  }

  test "Obtener telaDeAraña" {
    jugador.agregarAlInventario(telaDeAraña)
    jugador.agregarHilo()
    assert.equals([telaDeAraña], jugador.inventarioActual())
    assert.equals(1, jugador.hiloActual())
  }

}

import wollok.game.*

import juego.jugador
import juego.araña

object config {

	method configurarEscenario() {
		game.title("TheIsla")
		game.height(10)
		game.width(10)
	}
	
}
program PepitaGame {

	config.configurarEscenario()
	
	game.addVisualCharacter(jugador)
	game.addVisual(araña)
	game.start()
}
